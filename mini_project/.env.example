# ── .env.example (버릴지도) ───────────────────────────────────
# 이 파일은 «어떤 키가 필요한지» 만 보여 줍니다. 값은 저장소 맨 위의 .env (루트, 하나뿐) 에 적습니다.
# ⚠️ 루트 .env 는 .gitignore 되어 있습니다. 토큰을 코드 · 커밋 · 슬랙 메시지에 넣지 마세요.

# ── 필수 ──
SLACK_BOT_TOKEN=xoxb-...          # 보내는 선 (chat:write)
SLACK_APP_TOKEN=xapp-...          # 받는 선 (Socket Mode)
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true            # ★ 추적 캡처는 필수 제출물 — false 면 trace 가 남지 않습니다

# LANGSMITH_PROJECT 는 넣지 않습니다 — config.py 가 «recycle-bot-20241499» 로 정합니다
#   (루트에 넣으면 다른 주차 실습의 trace 까지 이 프로젝트로 섞입니다)
# MODEL · EMBED_MODEL 은 다른 주차 실습용 키입니다 — 이 프로젝트는 읽지 않습니다. 건드리지 마세요.

# ── (선택) 바꿔서 잴 때만 — 없으면 코드 기본값 ──
# RECYCLE_MODEL=hf.co/mykor/A.X-4.0-Light-gguf:Q4_K_M     # 생성. 문제가 생기면 exaone3.5:2.4b (인덱스 재생성 불필요)
# RECYCLE_EMBED_MODEL=hf.co/mykor/KURE-v1-gguf:Q8_0        # 임베딩. 바꾸면 python build_index.py 를 다시
# RECYCLE_STRATEGY=basic                                   # basic | multiquery
# RECYCLE_YEAR_BONUS=0                                     # year >= 2020 문서의 거리에서 빼 줄 값
# RECYCLE_PROMPT=base                                      # base | recent
# RECYCLE_INDEX=index_recycle                              # 인덱스 폴더 이름
# RECYCLE_LANGSMITH_PROJECT=recycle-bot-20241499
